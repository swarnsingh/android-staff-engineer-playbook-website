    "path": "patterns/circuit-breaker",
    "diagram": "782d1a35f796f88d",
    "number": 1,
    "title": "Recovery depends on the half-open probe",
    "caption": "The breaker starts closed. Enough recorded failures open it. After the wait, a bounded probe can close the breaker on success or return it to open on failure.",
    "sources": [
      "https://resilience4j.readme.io/docs/circuitbreaker"
    ],
    "kind": "map",
    "nodes": [
      {
        "id": "initial",
        "title": "Initial state",
        "role": "neutral",
        "detail": "Breaker starts",
        "col": 0,
        "row": 0
      },
      {
        "id": "closed",
        "title": "Closed",
        "role": "runtime",
        "detail": "Admit normal calls",
        "col": 0,
        "row": 1
      },
      {
        "id": "open",
        "title": "Open",
        "role": "runtime",
        "detail": "Reject ordinary calls",
        "col": 0,
        "row": 2
      },
      {
        "id": "half",
        "title": "Half-open",
        "role": "runtime",
        "detail": "Admit limited probes",
        "col": 0,
        "row": 3
      }
    ],
    "edges": [
      {
        "from": "initial",
