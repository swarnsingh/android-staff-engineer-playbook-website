  {
    "path": "security/certificate-pinning",
    "diagram": "6ffcade25b38f831",
    "kind": "map",
    "number": 1,
    "title": "Overlapping installed pins permit planned server rotation",
    "caption": "Ship the next accepted public key before rotating the server identity. Without overlap, a supported installed cohort can fail even though a newer cohort connects; recovery through that blocked channel cannot be assumed.",
    "nodes": [
      {
        "id": "old",
        "title": "Installed cohort",
        "role": "client",
        "detail": "K1 plus backup K2"
      },
      {
        "id": "rot",
        "title": "Server rotation",
        "role": "runtime",
        "detail": "Valid chain using K2"
      },
      {
        "id": "ok",
        "title": "Overlapping cohort",
        "role": "client",
        "detail": "Chain and pin pass"
      },
      {
        "id": "next",
        "title": "Later app release",
        "role": "client",
        "detail": "K2 plus next backup"
      },
      {
        "id": "bad",
        "title": "No overlapping pin",
        "role": "client",
        "detail": "Connection rejected"
      }
    ],
    "edges": [
      {
        "from": "old",
        "to": "rot",
        "label": "backup distributed first"
      },
      {
        "from": "rot",
        "to": "ok",
        "label": "K2 already accepted"
      },
      {
        "from": "ok",
        "to": "next",
        "label": "advance overlap deliberately"
      },
      {
        "from": "rot",
        "to": "bad",
        "label": "old cohort lacks K2"
      }
    ],
    "sources": [
      "https://developer.android.com/privacy-and-security/security-config",
      "https://developer.android.com/privacy-and-security/security-ssl"
    ]
  },
