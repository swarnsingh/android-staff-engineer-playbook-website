        "role": "runtime",
        "detail": "Check the raw value"
      },
      {
        "id": "pass",
        "title": "Business logic",
        "role": "runtime",
        "detail": "Still receives a raw value"
      },
      {
        "id": "throw",
        "title": "Runtime exception",
        "role": "runtime",
        "detail": "Example failure path"
      },
      {
        "id": "r2",
        "title": "Raw input",
        "role": "neutral",
        "detail": "Untrusted input"
      },
      {
        "id": "parse",
        "title": "Factory or constructor",
        "role": "runtime",
        "detail": "Check at the boundary"
      },
      {
        "id": "reject",
        "title": "Error or null",
        "role": "runtime",
        "detail": "Rejected input"
      },
      {
        "id": "valid",
        "title": "Validated domain value",
        "role": "storage",
        "detail": "Checked invariant"
      },
      {
        "id": "domain",
        "title": "Domain logic",
        "role": "runtime",
        "detail": "Consumes the domain value"
      }
    ],
    "edges": [
      {
        "from": "r1",
        "to": "check",
        "label": "validate"
      },
      {
        "from": "check",
        "to": "pass",
        "label": "pass"
      },
      {
        "from": "check",
        "to": "throw",
        "label": "fail"
      },
      {
        "from": "r2",
        "to": "parse",
        "label": "parse"
      },
      {
        "from": "parse",
        "to": "reject",
        "label": "reject invalid input"
      },
      {
        "from": "parse",
        "to": "valid",
        "label": "accept valid input"
