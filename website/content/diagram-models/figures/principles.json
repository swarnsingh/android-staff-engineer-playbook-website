  {
    "path": "principles/make-invalid-states-impossible",
    "diagram": "3a5eab6a3f11c280",
    "kind": "map",
    "number": 1,
    "title": "Put validation where raw input becomes a domain value",
    "caption": "The left path performs a check while continuing to work with raw input. On the right, a validated value makes the checked invariant available to domain code. Rejected input leaves through a separate path.",
