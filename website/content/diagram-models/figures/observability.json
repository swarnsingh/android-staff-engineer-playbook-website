      },
      {
        "from": "Net",
        "to": "Gateway",
        "label": "POST checkout with carrier"
      },
      {
        "over": "Gateway",
        "text": "Validate carrier; continue or re-root"
      },
      {
        "from": "Gateway",
        "to": "O11y",
        "label": "Export gateway span"
      },
      {
        "from": "Gateway",
        "to": "BE",
        "label": "Propagate accepted server context"
      },
      {
        "from": "BE",
        "to": "DB",
        "label": "Query data"
      },
      {
        "from": "DB",
        "to": "BE",
