<script type="application/json">{"nodes": [{"id": "up", "label": "Upstream query", "art": {"kind": "database", "role": "storage"}}, {"id": "state", "label": "Shared StateFlow", "art": {"kind": "flow", "role": "storage"}}, {"id": "ui", "label": "Screen collector", "art": {"kind": "phone", "role": "client"}}], "layouts": {"wide": {"size": [760, 290], "nodes": {"up": {"x": 24, "y": 50, "w": 208, "h": 140}, "state": {"x": 276, "y": 50, "w": 208, "h": 140}, "ui": {"x": 528, "y": 50, "w": 208, "h": 140}}, "edges": {"subscribe": "M526 138 C506 138 506 138 486 138", "collect": "M274 138 C254 138 254 138 234 138", "value": "M234 102 C254 102 254 102 274 102", "render": "M486 102 C506 102 506 102 526 102"}, "pk": {"dx": 0, "dy": -17, "anchor": "middle"}}, "narrow": {"size": [320, 470], "nodes": {"up": {"x": 40, "y": 22, "w": 240, "h": 140}, "state": {"x": 8, "y": 252, "w": 144, "h": 190}, "ui": {"x": 168, "y": 252, "w": 144, "h": 190}}, "edges": {"subscribe": "M166 365 C160 365 160 365 154 365", "collect": "M98 250 C98 207 178 207 178 164", "value": "M142 164 C142 207 62 207 62 250", "render": "M154 329 C160 329 160 329 166 329"}, "pk": {"dx": 0, "dy": -17, "anchor": "middle"}}}, "modes": {"run": {"initial": {"nodes": {"up": ["", "not collected"], "state": ["", "Loading"], "ui": ["", "no subscriber"]}, "visuals": {"state": {"empty": true}, "ui": {"visible": false, "rows": 0}}}, "steps": [{"caption": "This stateIn uses WhileSubscribed(5000), its default replay retention, and a ViewModel-owned scope. Before a subscriber appears, it holds Loading without collecting upstream."}, {"caption": "The screen starts collecting. The first subscriber starts the shared upstream.", "packets": [{"edge": "subscribe", "label": "subscribe", "tone": "back", "kind": "signal"}], "set": {"nodes": {"ui": ["is-active", "subscribed"], "state": ["is-active", "sharing started"]}, "visuals": {"ui": {"visible": true}}}}, {"caption": "The sharing coroutine starts collecting the upstream query. Several subscribers still share this one collection.", "packets": [{"edge": "collect", "label": "collect", "tone": "back", "kind": "signal"}], "set": {"nodes": {"up": ["is-active", "query observed"]}}}, {"caption": "An upstream value updates the StateFlow. The latest value is retained independently of screen collection.", "packets": [{"edge": "value", "label": "42 users", "tone": "fwd", "kind": "rows"}], "set": {"nodes": {"state": ["is-done", "Success(42)"]}, "visuals": {"state": {"empty": false, "value": 42}}}}, {"caption": "The screen receives the value. A short subscriber gap during rotation can end before the configured stop timeout, keeping upstream alive.", "packets": [{"edge": "render", "label": "state", "tone": "fwd", "kind": "rows"}], "set": {"nodes": {"ui": ["is-done", "shows 42 users"]}, "visuals": {"ui": {"rows": 3}}}}, {"caption": "The last subscriber leaves. After the configured five seconds, upstream collection stops. With default replay retention, Success(42) remains cached.", "set": {"nodes": {"up": ["", "collection stopped"], "ui": ["", "no subscribers"], "state": ["is-done", "Success(42) cached"]}, "visuals": {"ui": {"visible": false}}}}, {"caption": "A later subscriber receives the retained value and restarts sharing. Keeping the value does not mean the stopped query was still running.", "packets": [{"edge": "render", "label": "cached state", "tone": "fwd", "kind": "rows"}], "set": {"nodes": {"ui": ["is-active", "subscribed again"], "up": ["is-active", "collection restarted"]}, "visuals": {"ui": {"visible": true}}}}]}}, "illustrated": true, "edgeEndpoints": {"subscribe": {"from": "ui", "to": "state"}, "collect": {"from": "state", "to": "up"}, "value": {"from": "up", "to": "state"}, "render": {"from": "state", "to": "ui"}}}</script>
<p class="pb-sub">Sources: <a href="https://kotlinlang.org/api/kotlinx.coroutines/kotlinx-coroutines-core/kotlinx.coroutines.flow/-sharing-started/-companion/-while-subscribed.html">WhileSubscribed contract</a>.</p>
