ption": "The screen receives the value. A short subscriber gap during rotation can end before the configured stop timeout, keeping upstream alive.", "packets": [{"edge": "render", "label": "state", "tone": "fwd"}], "set": {"nodes": {"ui": ["is-done", "shows 42 users"]}}}, {"caption": "The last subscriber leaves. After the configured five seconds, upstream collection stops. With default replay retention, Success(42) remains cached.", "set": {"nodes": {"up": ["", "collection stopped"], "ui": ["", "no subscribers"], "state": ["is-done", "Success(42) cached"]}}}, {"caption": "A later subscriber receives the retained value and restarts sharing. Keeping the value does not mean the stopped query was still running.", "packets": [{"edge": "render", "label": "cached state", "tone": "fwd"}], "set": {"nodes": {"ui": ["is-active", "subscribed again"], "up": ["is-active", "collection restarted"]}}}]}}}</script>
