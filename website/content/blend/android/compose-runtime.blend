"recomposer": ["is-active", "work pending"]}, "visuals": {"state": {"empty": false}, "recomposer": {"ready": true}}}}, {"caption": "The Recomposer performs scheduled work. The affected restart scope runs again; skipping other calls depends on their actual inputs and state dependencies.", "packets": [{"edge": "restart", "label": "restart scope", "tone": "fwd", "kind": "signal"}], "set": {"nodes": {"scope": ["is-active", "recompose query reader"]}}}, {"caption": "The recomposed result supplies changes for the UI node tree. This is a conceptual change path, not a virtual-DOM diff or a cross-thread message guarantee.", "packets": [{"edge": "apply", "label": "apply changes", "tone": "fwd", "kind": "parcel"}], "set": {"nodes": {"ui": ["is-active", "apply changed text"]}}}, {"caption": "The UI tree now reflects cat. Required layout and drawing work follows its own phase dependencies; unchanged structure does not imply that every later phase must run.", "set": {"nodes": {"ui": ["is-done", "text = cat"], "recomposer": ["", "await next work"], "scope": ["is-done", "new state read"]}, "visuals": {"ui": {"rows": 3}, "recomposer": {"ready": false}}}}]}}, "illustrated": true, "edgeEndpoints": {"invalidate": {"from": "state", "to": "recomposer"}, "restart": {"from": "recomposer", "to": "scope"}, "apply": {"from": "scope", "to": "ui"}}}</script>
