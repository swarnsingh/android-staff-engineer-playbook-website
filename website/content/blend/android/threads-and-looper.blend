t": {"nodes": {"queue": ["", "delayed only"], "main": ["is-active", "running onClick"]}, "queue": 1}}, {"caption": "The old activity is destroyed. Its delayed Runnable is still queued and still captures it; this lifecycle change sends no message from the touch callback to the delayed callback.", "set": {"nodes": {"poster": ["is-warn", "old activity gone"], "main": ["", "available"], "queue": ["is-warn", "retains old activity"]}, "visuals": {"poster": {"visible": false}, "main": {"busy": false}}}}, {"caption": "If it is left queued, the delayed callback can run when due against stale UI ownership. A crash is possible, not inevitable. Cancel or detach work at its ownership boundary.", "packets": [{"edge": "dispatch", "label": "delayed", "tone": "stuck", "kind": "parcel"}], "set": {"nodes": {"queue": ["", "drained"], "main": ["is-warn", "stale UI update"]}, "queue": 0, "visuals": {"main": {"busy": true}}}}]}}, "illustrated": true, "edgeEndpoints": {"post": {"from": "poster", "to": "queue"}, "dispatch": {"from": "queue", "to": "main"}}}</script>
