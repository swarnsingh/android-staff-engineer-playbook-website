odes": {"ui": ["", "not collecting"]}}}, {"caption": "The producer emits LoginComplete. With no subscribers and replay zero, emit returns immediately and the event is lost.", "packets": [{"edge": "write", "label": "LoginComplete", "tone": "fwd"}], "set": {"nodes": {"producer": ["is-done", "login finished"], "hot": ["is-warn", "nothing retained"]}}}, {"caption": "The screen returns. There is no replayed event to deliver, so no packet reaches it. Model durable product state separately from a transient effect.", "set": {"nodes": {"ui": ["is-warn", "no past event"]}}}]}}}</script>
