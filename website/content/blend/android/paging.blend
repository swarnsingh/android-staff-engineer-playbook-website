etch page"]}}}, {"caption": "The API returns a page and its continuation information. Key rules and end-of-pagination conditions belong to this API.", "packets": [{"edge": "response", "label": "page", "tone": "back"}], "set": {"nodes": {"mediator": ["is-active", "page received"], "net": ["is-done", "response ready"]}}}, {"caption": "The mediator commits rows and the associated remote-key changes transactionally. The network result becomes database state.", "packets": [{"edge": "commit", "label": "commit", "tone": "fwd"}], "set": {"nodes": {"db": ["is-done", "rows + keys committed"], "mediator": ["is-done", "load success"]}}}, {"caption": "The database update invalidates the old PagingSource. A new source loads the committed rows for Paging to display; cache loading and remote load states remain distinct.", "packets": [{"edge": "rows", "label": "fresh rows", "tone": "back"}], "set": {"nodes": {"paging": ["is-done", "new database rows"]}}}]}}}</script>
