kets": [{"edge": "load", "label": "load", "tone": "fwd", "kind": "parcel"}], "set": {"nodes": {"mediator": ["is-active", "load requested"]}}}, {"caption": "The mediator requests the next page using this dataset’s remote key.", "packets": [{"edge": "fetch", "label": "page key", "tone": "fwd", "kind": "rows"}], "set": {"nodes": {"net": ["is-active", "fetch page"]}}}, {"caption": "The API returns a page and its continuation information. Key rules and end-of-pagination conditions belong to this API.", "packets": [{"edge": "response", "label": "page", "tone": "back", "kind": "rows"}], "set": {"nodes": {"mediator": ["is-active", "page received"], "net": ["is-done", "response ready"]}}}, {"caption": "The mediator commits rows and the associated remote-key changes transactionally. The network result becomes database state.", "packets": [{"edge": "commit", "label": "commit", "tone": "fwd", "kind": "parcel"}], "set": {"nodes": {"db": ["is-done", "rows + keys committed"], "mediator": ["is-done", "load success"]}, "visuals": {}}}, {"caption": "The database update invalidates the old PagingSource. A new source loads the committed rows for Paging to display; cache loading and remote load states remain distinct.", "packets": [{"edge": "rows", "label": "fresh rows", "tone": "back", "kind": "rows"}], "set": {"nodes": {"paging": ["is-done", "new database rows"]}, "visuals": {"paging": {"rows": 3}}}}]}}, "illustrated": true, "edgeEndpoints": {"load": {"from": "paging", "to": "mediator"}, "fetch": {"from": "mediator", "to": "net"}, "response": {"from": "net", "to": "mediator"}, "commit": {"from": "mediator", "to": "db"}, "rows": {"from": "db", "to": "paging"}}}</script>
