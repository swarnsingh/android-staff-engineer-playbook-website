<!-- @after Migration Patterns :: animation -->
### Migrate one contract, then widen

<figure class="stepper"><span class="stepper-title">One repository, two implementations during a staged migration</span><div class="stage viz-stack"><div class="node" data-el="contract"><strong>Domain-facing API</strong><small data-text="contractV">—</small></div><div class="node" data-el="old"><strong>Existing adapter</strong><small data-text="oldV">—</small></div><div class="node" data-el="new"><strong>Candidate adapter</strong><small data-text="newV">—</small></div><div class="node" data-el="gate"><strong>Release decision</strong><small data-text="gateV">—</small></div></div><script type="application/json" class="steps">[
{
"label": "Pin behaviour",
"caption": "Choose one representative operation and write down its data, auth, error and cancellation contract.",
"state": {
"contract": "active"
},
"text": {
"contractV": "getUser(id) → domain result",
"oldV": "currently selected",
"newV": "not selected",
"gateV": "baseline recorded"
},
"add": [
"contract",
"old",
"new",
"gate"
]
},
{
"label": "Add an adapter",
"caption": "Implement that contract using the candidate stack behind the existing application boundary.",
"state": {
"new": "active",
"old": "done"
},
"text": {
"newV": "candidate implementation"
}
},
{
"label": "Exercise parity",
"caption": "Run equivalent fixtures on the engines and targets the product actually ships.",
"state": {
"gate": "active"
},
"text": {
"gateV": "contract + transport tests"
}
},
{
"label": "Roll out selectively",
"caption": "Select one implementation per call path. Observe failures and performance; keep rollback available.",
"state": {
"new": "done",
"gate": "active"
},
"text": {
"gateV": "measured rollout"
}
},
{
"label": "Retire deliberately",
"caption": "Remove old dependencies only after their final owned call path and configuration are retired.",
"state": {
"old": "ghost",
"contract": "done",
"gate": "done"
},
"text": {
"oldV": "removed when unused",
"gateV": "migration complete"
}
}
]</script><figcaption>This sequence is an application migration plan; its outcome depends on measured parity, not on endpoint count alone.</figcaption></figure>

