<!-- @after 6. Advanced: Conditional iOS CI :: animation -->
### Select work without losing a promised gate

<figure class="stepper"><span class="stepper-title">Changes become required evidence, then a release</span><div class="stage viz-stack"><div class="node" data-el="change"><strong>Change scope</strong><small data-text="changeV">—</small></div><div class="node" data-el="linux"><strong>JVM/common checks</strong><small data-text="linuxV">—</small></div><div class="node" data-el="apple"><strong>Apple-capable checks</strong><small data-text="appleV">—</small></div><div class="node" data-el="release"><strong>Artifact release</strong><small data-text="releaseV">—</small></div></div><script type="application/json" class="steps">[
{
"label": "Classify impact",
"caption": "Map the change to affected consumers, including shared tooling and generated API—not just edited source files.",
"state": {
"change": "active"
},
"text": {
"changeV": "affected contracts recorded",
"linuxV": "planned",
"appleV": "planned if required",
"releaseV": "not eligible"
},
"add": [
"change",
"linux",
"apple",
"release"
]
},
{
"label": "Run sufficient checks",
"caption": "Run target-capable jobs for the required pre-merge promises. Keep their results visible independently.",
"state": {
"linux": "active",
"apple": "active"
},
"text": {
"linuxV": "result + reports",
"appleV": "result + reports"
}
},
{
"label": "Decide merge",
"caption": "A selection rule must preserve the declared compatibility gate. Missing required target evidence is not success.",
"state": {
"change": "done",
"release": "warn"
},
"text": {
"releaseV": "gate decision"
}
},
{
"label": "Release artifact",
"caption": "Release packaging adds immutable metadata, consumer resolution/link checks and diagnostics.",
"state": {
"release": "active"
},
"text": {
"releaseV": "tested artifact + identity + consumer evidence"
}
}
]</script><figcaption>This is a decision trace. Job names, runner architecture, cache hit rates and costs come from the actual project and current provider contract.</figcaption></figure>

