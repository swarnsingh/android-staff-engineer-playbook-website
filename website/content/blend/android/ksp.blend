: {"nodes": {"processor": ["is-active", "inspect symbols"]}}}, {"caption": "A processor generates the missing declaration as a source file. Code generation produces a file; it does not rewrite an existing source declaration.", "packets": [{"edge": "write", "label": "source file", "tone": "fwd", "kind": "page"}], "set": {"nodes": {"files": ["is-done", "new declaration"]}, "visuals": {"files": {"visible": true}}}}, {"caption": "The next round exposes newly generated declarations as additional input. Re-query through the current Resolver rather than retaining symbols across rounds.", "packets": [{"edge": "round", "label": "new symbols", "tone": "back", "kind": "page"}], "set": {"nodes": {"symbols": ["is-active", "new round inputs"], "processor": ["", "round 2"]}}}, {"caption": "The deferred source symbol can now validate and be processed. A round that generates no new files ends processing; unresolved deferred symbols then produce errors.", "set": {"nodes": {"processor": ["is-done", "deferred symbol resolved"]}}}, {"caption": "Generated source participates in compilation. A successful processing round does not establish consumer-module wiring or runtime reflection keep rules.", "packets": [{"edge": "compile", "label": "generated source", "tone": "fwd", "kind": "page"}], "set": {"nodes": {"compiler": ["is-done", "generated code compiled"]}, "visuals": {"compiler": {"built": true}}}}]}}, "illustrated": true, "edgeEndpoints": {"symbols": {"from": "symbols", "to": "processor"}, "write": {"from": "processor", "to": "files"}, "round": {"from": "files", "to": "symbols"}, "compile": {"from": "files", "to": "compiler"}}}</script>
