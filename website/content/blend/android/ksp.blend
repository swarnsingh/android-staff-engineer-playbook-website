on"]}}}, {"caption": "The next round exposes newly generated declarations as additional input. Re-query through the current Resolver rather than retaining symbols across rounds.", "packets": [{"edge": "round", "label": "new symbols", "tone": "back"}], "set": {"nodes": {"symbols": ["is-active", "new round inputs"], "processor": ["", "round 2"]}}}, {"caption": "The deferred source symbol can now validate and be processed. A round that generates no new files ends processing; unresolved deferred symbols then produce errors.", "set": {"nodes": {"processor": ["is-done", "deferred symbol resolved"]}}}, {"caption": "Generated source participates in compilation. A successful processing round does not establish consumer-module wiring or runtime reflection keep rules.", "packets": [{"edge": "compile", "label": "generated source", "tone": "fwd"}], "set": {"nodes": {"compiler": ["is-done", "generated code compiled"]}}}]}}}</script>
