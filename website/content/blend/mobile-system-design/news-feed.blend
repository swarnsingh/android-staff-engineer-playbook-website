      "pager": "active",
      "room": "done",
      "ui": "active",
      "outbox": "done"
    },
    "text": {
      "pagerV": "restarted from Room",
      "roomV": "rows and nextCursor",
      "uiV": "saved index or top",
      "outboxV": "empty",
      "eventV": "the index only holds if the rows didn’t change"
    }
  },
  {
    "label": "A hint arrives",
    "caption": "A normal-priority FCM message says new posts exist. onMessageReceived drops it if accountId isn’t the signed-in account, then updates a badge held in memory. Nothing reorders under the scroll: only a tap refreshes and returns to the top.",
    "state": {
      "hint": "active",
      "ui": "active",
      "pager": "done"
    },
    "text": {
      "hintV": "feed.new, count 3",
      "uiV": "banner: new posts",
      "pagerV": "reads Room",
      "eventV": "a hint changes a badge, not the list"
    },
    "handoff": {
      "from": "hint",
      "to": "ui",
      "kind": "parcel",
      "label": "count"
    }
  },
  {
    "label": "Sign-out ends the account’s data",
    "caption": "Sign-out deletes the account’s rows, keys and queued likes, so a like still queued is lost. It also clears Coil’s memory and disk caches, which aren’t keyed by account. Popping the navigation graph without saving state clears the ViewModel, the saved index and the in-memory pages.",
    "state": {
      "room": "warn",
      "outbox": "warn",
      "ui": "done",
      "hint": "done",
      "event": "done"
    },
    "text": {
