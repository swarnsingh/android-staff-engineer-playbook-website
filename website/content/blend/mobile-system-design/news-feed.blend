      "mediator": "active"
    },
    "text": {
      "uiV": "cached rows",
      "mediatorV": "initialize()",
      "eventV": "cache age decides whether to refresh"
    },
    "handoff": {
      "from": "room",
      "to": "ui",
      "kind": "rows",
      "label": "cached rows"
    }
  },
  {
    "label": "REFRESH swaps in one transaction",
    "caption": "REFRESH fetches with no cursor. Only after the response does one transaction clear this account’s rows, insert the page with positions from 0, save nextCursor and re-apply queued likes. A failed request keeps the cache. The list orders by position because the order is the server’s.",
    "state": {
      "api": "done",
      "room": "active",
      "mediator": "done"
    },
    "text": {
      "apiV": "ranked page",
      "mediatorV": "REFRESH",
      "roomV": "page 1 + nextCursor",
      "eventV": "a failed refresh keeps the old rows"
    },
    "handoff": {
      "from": "api",
      "to": "room",
      "kind": "rows",
      "label": "page + cursor"
    }
  },
  {
    "label": "APPEND uses the stored cursor",
    "caption": "When Room runs out, the mediator sends the stored nextCursor, and new rows continue from the highest position. A null cursor ends pagination. A failed page sets LoadState.Error: the rows already shown stay, with an inline retry chip.",
    "state": {
      "mediator": "warn",
      "api": "error",
      "ui": "warn",
      "room": "done"
    },
    "text": {
      "mediatorV": "APPEND",
